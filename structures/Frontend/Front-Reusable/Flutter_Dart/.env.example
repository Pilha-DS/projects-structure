# Copie para .env e injete no build com:
#   flutter run -d chrome --dart-define-from-file=.env
#
# No Flutter Web os valores entram no BUILD (não há leitura de .env em runtime).

# URL base da API consumida pelo app (obrigatória)
API_URL=http://localhost:8080

# Ambiente: development | staging | production
APP_ENV=development
