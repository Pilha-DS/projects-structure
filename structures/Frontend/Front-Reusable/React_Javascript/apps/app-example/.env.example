# Copie para .env (ou apps/<app>/.env) antes de rodar.
#
# No Vite, APENAS variáveis com prefixo VITE_ chegam ao código do cliente,
# via import.meta.env. Elas entram no BUILD — não há leitura em runtime.
#
# ⚠️ Tudo com prefixo VITE_ é PÚBLICO no bundle final. Nunca coloque segredos.

# URL base da API consumida pelo app (obrigatória)
VITE_API_URL=http://localhost:8080

# Ambiente: development | staging | production
VITE_APP_ENV=development
